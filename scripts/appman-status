#!/bin/bash
# List installed AppMan apps and write ~/.local/state/omarchy/appman.json.
# Local only — no network, safe to poll from the bar.
set -euo pipefail

# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

if ! appman_ready; then
  fail_state "AppMan is not installed"
  exit 1
fi

if ! try_lock; then
  # Another check or upgrade is already running; surface the current file.
  read_state
  exit 0
fi

merge_state "$(jq -nc '{checking: true, error: ""}')"

raw="$("$APPMAN" -f --byname 2>/dev/null || true)"
# Strip ANSI colors. The table layout varies between AppMan releases
# (older: APPNAME | DB | VERSION | TYPE | SIZE, newer: no DB column),
# so map row fields by the header instead of fixed positions.
clean="$(printf '%s\n' "$raw" | sed 's/\x1b\[[0-9;]*m//g')"
header="$(printf '%s\n' "$clean" | grep -m1 '^ - APPNAME' || true)"
rows="$(printf '%s\n' "$clean" | grep '^ ◆ ' || true)"

apps="[]"
if [[ -n $rows ]]; then
  apps="$(jq -nc --arg header "$header" --arg rows "$rows" '
    ($header | split("|") | map(ascii_downcase | sub("^ *- *"; "") | gsub("^ +| +$"; ""))) as $cols
    | ($cols | index("appname")) as $ci
    | ($cols | index("db")) as $di
    | ($cols | index("version")) as $vi
    | ($cols | index("type")) as $ti
    | ($cols | index("size")) as $si
    | ($rows | split("\n") | map(select(length > 0)))
    | map(split("|") | map(gsub("^ +| +$"; "")) | . as $f
      | {name: ((if $ci == null then $f[0] else $f[$ci] end) | sub("^◆ +"; "")),
         db: (if $di == null then "" else ($f[$di] // "") end),
         version: (if $vi == null then "" else ($f[$vi] // "") end),
         type: (if $ti == null then "" else ($f[$ti] // "") end),
         size: (if $si == null then "" else ($f[$si] // "") end)}
      | select(.name != ""))')"
fi

state="$(jq -nc --argjson checkedAt "$(now_unix)" --argjson apps "$apps" '{
  ok: true,
  checkedAt: $checkedAt,
  checking: false,
  updating: false,
  error: "",
  apps: $apps
}')"

write_state_file "$state"
printf '%s\n' "$state"
